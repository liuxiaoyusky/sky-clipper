{
  "name": "fin-report-clipper",
  "displayName": "Fin-report-clipper",
  "description": "在 Chrome 中自动识别并归档受支持的金融研报",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:ascii": "node scripts/check-content-ascii.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "verify": "npm test && npm run compile && npm run build && npm run check:ascii && npm run check:manifest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wxt": "^0.19.13"
  },
  "overrides": {
    "shell-quote": "1.8.4",
    "tar": "7.5.19",
    "tmp": "0.2.7",
    "uuid": "11.1.1"
  }
}
